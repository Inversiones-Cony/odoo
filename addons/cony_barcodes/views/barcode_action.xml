<odoo>
    <record id="action_print_barcode" model="ir.actions.server">
        <field name="name">Print Barcodes</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="code">
            action = env.ref('cony_barcodes.report_product_barcode').report_action(env['product.template'].browse(env.context.get('active_ids', [])))
        </field>
    </record>
</odoo>

