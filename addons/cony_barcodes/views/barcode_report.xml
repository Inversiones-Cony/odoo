<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <report 
        id="report_product_barcode"
        model="product.template"
        string="Print Barcodes"
        report_type="qweb-pdf"
        name="cony-barcodes.report_product_barcode_template"
        file="cony-barcodes.report_product_barcode_template"
    />

    <template id="report_product_barcode_template">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-foreach="docs" t-as="product">
                    <div class="barcode-label">
                        <strong><t t-esc="product.name[:20]"/></strong><br/>
                        Price: <t t-esc="product.list_price"/> <br/>
                        <img t-att-src="'data:image/png;base64,' + product.generate_barcode_base64()"/>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>

