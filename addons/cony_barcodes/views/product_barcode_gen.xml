<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Server Action for Product Templates -->
    <record id="action_generate_ean13_template" model="ir.actions.server">
        <field name="name">Generate EAN13 Barcodes</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.action_generate_ean13_multi()</field>
    </record>
    
    <!-- Server Action for Product Variants -->
    <record id="action_generate_ean13_product" model="ir.actions.server">
        <field name="name">Generate EAN13 Barcodes</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.action_generate_ean13_multi()</field>
    </record>
</odoo>
