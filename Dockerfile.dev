# syntax=docker/dockerfile:1

FROM python:3.11-slim

ARG TARGETARCH

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VENV_PATH=/opt/odoo/.venv \
    PATH="/opt/odoo/.venv/bin:$PATH"

# Install system dependencies required to run Odoo in development
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        dirmngr \
        fonts-noto-cjk \
        git \
        gnupg \
        libblas-dev \
        libffi-dev \
        libfreetype6-dev \
        libjpeg62-turbo-dev \
        libjpeg-dev \
        libldap2-dev \
        liblcms2-dev \
        libopenjp2-7 \
        libpq-dev \
        libsasl2-dev \
        libssl-dev \
        libwebp-dev \
        libxml2-dev \
        libxslt1-dev \
        libzip-dev \
        locales \
        nano \
        nodejs \
        npm \
        pkg-config \
        postgresql-client \
        unzip \
        wget \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install wkhtmltopdf (used for printed reports)
RUN if [ -z "${TARGETARCH}" ]; then TARGETARCH="$(dpkg --print-architecture)"; fi \
    && WKHTMLTOPDF_ARCH="${TARGETARCH}" \
    && case "${TARGETARCH}" in \
        amd64)   WKHTMLTOPDF_ARCH=amd64 && WKHTMLTOPDF_SHA=9df8dd7b1e99782f1cfa19aca665969bbd9cc159 ;; \
        arm64)   WKHTMLTOPDF_SHA=58c84db46b11ba0e14abb77a32324b1c257f1f22 ;; \
        ppc64el) WKHTMLTOPDF_SHA=7ed8f6dcedf5345a3dd4eeb58dc89704d862f9cd ;; \
        *)       echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
    esac \
    && curl -fsSL -o /tmp/wkhtmltox.deb https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.bullseye_${WKHTMLTOPDF_ARCH}.deb \
    && echo "${WKHTMLTOPDF_SHA} /tmp/wkhtmltox.deb" | sha1sum -c - \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/wkhtmltox.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/wkhtmltox.deb

# Install asset build tools
RUN npm install -g \
        less \
        less-plugin-clean-css \
        rtlcss

# Prepare an isolated Python environment with Odoo dependencies preinstalled
COPY requirements.txt /tmp/requirements.txt
RUN python -m venv "$VENV_PATH" \
    && "$VENV_PATH/bin/pip" install --upgrade pip setuptools wheel \
    && "$VENV_PATH/bin/pip" install -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# Create the odoo user and working directory that will receive the mounted source tree
RUN useradd -m -d /opt/odoo -s /bin/bash odoo \
    && mkdir -p /workspace/odoo \
    && chown -R odoo:odoo /workspace

WORKDIR /workspace/odoo

ENV ODOO_RC=/workspace/odoo/odoo.conf

# Switch to the unprivileged user for day-to-day development
USER odoo

# Default to an interactive shell so docker run -it works out of the box
ENTRYPOINT ["/bin/bash"]
CMD ["-lc", "cd /workspace/odoo && exec /bin/bash -i"]
